# ─── Copy to .env (never commit .env) ─────────────────────────────────────────

# MySQL 8+ / MariaDB 10.6+. Use a dedicated app user (see scripts/db/).
DATABASE_URL="mysql://ismile_app:change-me@localhost:3306/ismile_crm"
# Max pooled connections per server instance.
DB_CONNECTION_LIMIT=10

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Public base URL, used in password reset / invitation links.
APP_URL="http://localhost:3000"
# Absolute session lifetime; the cookie is renewed every 30 min while active.
SESSION_MAX_AGE_HOURS=8

# debug | info | warn | error
LOG_LEVEL="info"

# SMTP — required in production. In development, emails are printed to the console when unset.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="iSmile CRM <no-reply@example.com>"

# crwdForce: Mia drafts replies with Claude. Leave empty to keep Mia switched off.
ANTHROPIC_API_KEY=""

# Integration tests: a SEPARATE, disposable database. Tests delete its data.
# DATABASE_URL_TEST="mysql://ismile_app:change-me@localhost:3306/ismile_crm_test"

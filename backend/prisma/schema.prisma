// iSmile Clinic CRM — Prisma schema (MySQL / MariaDB).
// Mirrors 001_initial_schema.mysql.sql; the SQL migrations are the source of truth.
// Status columns are VARCHAR + CHECK in the database; their allowed values live in TypeScript.
// Run `npm run db:generate` after every change.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Clinic {
  id                  String               @id @default(uuid()) @db.Char(36)
  name                String               @db.VarChar(255)
  timezone            String               @default("Asia/Manila") @db.VarChar(255)
  currency            String               @default("PHP") @db.Char(3)
  settings            Json
  createdAt           DateTime             @default(now()) @map("created_at")
  broadcasts          Broadcast[]
  miaDrafts           MiaDraft[]
  appointmentChairs   AppointmentChair[]
  appointments        Appointment[]
  approvalRequests    ApprovalRequest[]
  auditLogs           AuditLog[]
  automationRules     AutomationRule[]
  bankAccounts        BankAccount[]
  claims              Claim[]
  clinicalFiles       ClinicalFile[]
  contacts            Contact[]
  conversations       Conversation[]
  encounters          Encounter[]
  expenseEntries      ExpenseEntry[]
  integrationAccounts IntegrationAccount[]
  invoiceVoidRequests InvoiceVoidRequest[]
  invoices            Invoice[]
  leadSources         LeadSource[]
  leads               Lead[]
  patients            Patient[]
  payers              Payer[]
  paymentPlans        PaymentPlan[]
  payments            Payment[]
  permissionRequests  PermissionRequest[]
  roles               Role[]
  serviceCatalog      Service[]
  treatmentPlans      TreatmentPlan[]
  users               User[]

  @@map("clinics")
}

model User {
  id                               String                   @id @default(uuid()) @db.Char(36)
  clinicId                         String                   @map("clinic_id") @db.Char(36)
  fullName                         String                   @map("full_name") @db.VarChar(255)
  jobTitle                         String?                  @map("job_title") @db.VarChar(120)
  email                            String                   @db.VarChar(255)
  username                         String?                  @db.VarChar(255)
  staffCode                        String?                  @map("staff_code") @db.VarChar(255)
  passwordHash                     String?                  @map("password_hash") @db.VarChar(255)
  status                           String                   @default("active") @db.VarChar(255)
  dentistCode                      String?                  @map("dentist_code") @db.VarChar(255)
  createdAt                        DateTime                 @default(now()) @map("created_at")
  updatedAt                        DateTime                 @default(now()) @updatedAt @map("updated_at")
  appointmentsAsDentist            Appointment[]            @relation("appointments_dentist_idTousers")
  appointmentsAsCreatedBy          Appointment[]            @relation("appointments_created_byTousers")
  approvalRequestsAsRequestedBy    ApprovalRequest[]        @relation("approval_requests_requested_byTousers")
  approvalRequestsAsDecidedBy      ApprovalRequest[]        @relation("approval_requests_decided_byTousers")
  auditLogs                        AuditLog[]
  clinicalFiles                    ClinicalFile[]
  conversations                    Conversation[]
  encounters                       Encounter[]
  invoiceVoidRequestsAsRequestedBy InvoiceVoidRequest[]     @relation("invoice_void_requests_requested_byTousers")
  invoiceVoidRequestsAsDecidedBy   InvoiceVoidRequest[]     @relation("invoice_void_requests_decided_byTousers")
  invoices                         Invoice[]
  leadActivities                   LeadActivity[]
  leads                            Lead[]
  messages                         Message[]
  passwordTokens                   PasswordToken[]
  patients                         Patient[]
  payments                         Payment[]
  permissionRequestsAsRequestedBy  PermissionRequest[]      @relation("permission_requests_requested_byTousers")
  permissionRequestsAsDecidedBy    PermissionRequest[]      @relation("permission_requests_decided_byTousers")
  securitySessions                 SecuritySession[]
  treatmentPlans                   TreatmentPlan[]
  userPermissionOverrides          UserPermissionOverride[]
  userRoles                        UserRole[]
  clinic                           Clinic                   @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "users_ibfk_1")

  broadcasts Broadcast[]

  miaDrafts MiaDraft[]

  @@unique([clinicId, email], map: "clinic_id")
  @@unique([clinicId, staffCode], map: "clinic_id_2")
  @@index([email])
  @@map("users")
}

model Patient {
  id                String            @id @default(uuid()) @db.Char(36)
  clinicId          String            @map("clinic_id") @db.Char(36)
  contactId         String            @unique(map: "contact_id") @map("contact_id") @db.Char(36)
  patientNo         String            @map("patient_no") @db.VarChar(255)
  dob               DateTime?         @db.Date
  sex               String?           @db.VarChar(255)
  medicalAlerts     String?           @map("medical_alerts") @db.Text
  medicalConditions String?           @map("medical_conditions") @db.Text
  medications       String?           @db.Text
  civilStatus       String?           @map("civil_status") @db.VarChar(40)
  occupation        String?           @db.VarChar(120)
  payerId           String?           @map("payer_id") @db.Char(36)
  hmoMemberNo       String?           @map("hmo_member_no") @db.VarChar(60)
  scPwdId           String?           @map("sc_pwd_id") @db.VarChar(60)
  primaryDentistId  String?           @map("primary_dentist_id") @db.Char(36)
  status            String            @default("active") @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at")
  appointments      Appointment[]
  automationJobs    AutomationJob[]
  clinicalFiles     ClinicalFile[]
  encounters        Encounter[]
  invoices          Invoice[]
  leads             Lead[]
  patientGuardians  PatientGuardian[]
  clinic            Clinic            @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "patients_ibfk_1")
  contact           Contact           @relation(fields: [contactId], references: [id], onUpdate: Restrict, map: "patients_ibfk_2")
  primaryDentist    User?             @relation(fields: [primaryDentistId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "patients_ibfk_3")
  payer             Payer?            @relation(fields: [payerId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "patients_payer_fkey")
  paymentPlans      PaymentPlan[]
  payments          Payment[]
  treatmentPlans    TreatmentPlan[]

  @@unique([clinicId, patientNo], map: "clinic_id")
  @@index([primaryDentistId], map: "primary_dentist_id")
  @@index([payerId], map: "payer_id")
  @@map("patients")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  clinicId   String   @map("clinic_id") @db.Char(36)
  actorId    String?  @map("actor_id") @db.Char(36)
  action     String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(255)
  entityId   String?  @map("entity_id") @db.Char(36)
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  ip         String?  @db.VarChar(45)
  occurredAt DateTime @default(now()) @map("occurred_at")
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "audit_logs_ibfk_1")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_logs_ibfk_2")

  @@index([actorId], map: "actor_id")
  @@index([clinicId, action, occurredAt], map: "audit_actor_idx")
  @@index([clinicId, entityType, entityId, occurredAt], map: "audit_entity_idx")
  @@map("audit_logs")
}

model RateLimit {
  id      String   @id
  count   Int
  resetAt DateTime @map("reset_at")

  @@index([resetAt], map: "rate_limits_reset_idx")
  @@map("rate_limits")
}

model AppointmentChair {
  id           String        @id @default(uuid()) @db.Char(36)
  clinicId     String        @map("clinic_id") @db.Char(36)
  name         String        @db.VarChar(255)
  clinic       Clinic        @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "appointment_chairs_ibfk_1")
  appointments Appointment[]

  @@unique([clinicId, name], map: "clinic_id")
  @@map("appointment_chairs")
}

model Appointment {
  id            String            @id @default(uuid()) @db.Char(36)
  clinicId      String            @map("clinic_id") @db.Char(36)
  patientId     String            @map("patient_id") @db.Char(36)
  dentistId     String?           @map("dentist_id") @db.Char(36)
  chairId       String?           @map("chair_id") @db.Char(36)
  serviceId     String?           @map("service_id") @db.Char(36)
  startsAt      DateTime          @map("starts_at")
  endsAt        DateTime          @map("ends_at")
  status        String            @default("booked") @db.VarChar(255)
  bookingSource String?           @map("booking_source") @db.VarChar(255)
  notes         String?           @db.Text
  createdById   String?           @map("created_by") @db.Char(36)
  createdAt     DateTime          @default(now()) @map("created_at")
  leads         Lead[]
  invoices      Invoice[]
  clinic        Clinic            @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "appointments_ibfk_1")
  patient       Patient           @relation(fields: [patientId], references: [id], onUpdate: Restrict, map: "appointments_ibfk_2")
  dentist       User?             @relation("appointments_dentist_idTousers", fields: [dentistId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_3")
  chair         AppointmentChair? @relation(fields: [chairId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_4")
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_5")
  createdBy     User?             @relation("appointments_created_byTousers", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "appointments_ibfk_6")
  encounters    Encounter[]

  @@index([clinicId, startsAt, dentistId], map: "appointments_calendar_idx")
  @@index([chairId], map: "chair_id")
  @@index([createdById], map: "created_by")
  @@index([dentistId], map: "dentist_id")
  @@index([patientId], map: "patient_id")
  @@index([serviceId], map: "service_id")
  @@map("appointments")
}

model ApprovalRequest {
  id            String    @id @default(uuid()) @db.Char(36)
  clinicId      String    @map("clinic_id") @db.Char(36)
  requestType   String    @map("request_type") @db.VarChar(255)
  subjectType   String    @map("subject_type") @db.VarChar(255)
  subjectId     String?   @map("subject_id") @db.Char(36)
  payload       Json
  requestedById String    @map("requested_by") @db.Char(36)
  status        String    @default("pending") @db.VarChar(255)
  decidedById   String?   @map("decided_by") @db.Char(36)
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "approval_requests_ibfk_1")
  requestedBy   User      @relation("approval_requests_requested_byTousers", fields: [requestedById], references: [id], onUpdate: Restrict, map: "approval_requests_ibfk_2")
  decidedBy     User?     @relation("approval_requests_decided_byTousers", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "approval_requests_ibfk_3")

  @@index([clinicId], map: "clinic_id")
  @@index([decidedById], map: "decided_by")
  @@index([requestedById], map: "requested_by")
  @@map("approval_requests")
}

model AutomationJob {
  id           String          @id @default(uuid()) @db.Char(36)
  ruleId       String?         @map("rule_id") @db.Char(36)
  patientId    String?         @map("patient_id") @db.Char(36)
  scheduledFor DateTime        @map("scheduled_for")
  status       String          @default("pending") @db.VarChar(255)
  dedupeKey    String          @unique(map: "dedupe_key") @map("dedupe_key") @db.VarChar(255)
  attempts     Int             @default(0)
  rule         AutomationRule? @relation(fields: [ruleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "automation_jobs_ibfk_1")
  patient      Patient?        @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "automation_jobs_ibfk_2")

  @@index([patientId], map: "patient_id")
  @@index([ruleId], map: "rule_id")
  @@map("automation_jobs")
}

model AutomationRule {
  id             String          @id @default(uuid()) @db.Char(36)
  clinicId       String          @map("clinic_id") @db.Char(36)
  ruleType       String          @map("rule_type") @db.VarChar(255)
  enabled        Boolean         @default(false)
  config         Json
  automationJobs AutomationJob[]
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "automation_rules_ibfk_1")

  @@index([clinicId], map: "clinic_id")
  @@map("automation_rules")
}

model BankAccount {
  id               String            @id @default(uuid()) @db.Char(36)
  clinicId         String            @map("clinic_id") @db.Char(36)
  label            String            @db.VarChar(255)
  lastFour         String?           @map("last_four") @db.VarChar(255)
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "bank_accounts_ibfk_1")
  bankTransactions BankTransaction[]

  @@index([clinicId], map: "clinic_id")
  @@map("bank_accounts")
}

model BankTransaction {
  id               String      @id @default(uuid()) @db.Char(36)
  bankAccountId    String      @map("bank_account_id") @db.Char(36)
  postedOn         DateTime    @map("posted_on") @db.Date
  amount           Decimal     @db.Decimal(12, 2)
  description      String?     @db.Text
  matchedPaymentId String?     @map("matched_payment_id") @db.Char(36)
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id], onUpdate: Restrict, map: "bank_transactions_ibfk_1")
  matchedPayment   Payment?    @relation(fields: [matchedPaymentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "bank_transactions_ibfk_2")

  @@index([bankAccountId], map: "bank_account_id")
  @@index([matchedPaymentId], map: "matched_payment_id")
  @@map("bank_transactions")
}

model Claim {
  id             String    @id @default(uuid()) @db.Char(36)
  clinicId       String    @map("clinic_id") @db.Char(36)
  invoiceId      String    @map("invoice_id") @db.Char(36)
  payerId        String    @map("payer_id") @db.Char(36)
  claimNo        String?   @map("claim_no") @db.VarChar(255)
  status         String    @default("draft") @db.VarChar(255)
  submittedAt    DateTime? @map("submitted_at")
  approvedAmount Decimal?  @map("approved_amount") @db.Decimal(12, 2)
  loaNo          String?   @map("loa_no") @db.VarChar(60)
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "claims_ibfk_1")
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onUpdate: Restrict, map: "claims_ibfk_2")
  payer          Payer     @relation(fields: [payerId], references: [id], onUpdate: Restrict, map: "claims_ibfk_3")

  @@index([clinicId], map: "clinic_id")
  @@index([invoiceId], map: "invoice_id")
  @@index([payerId], map: "payer_id")
  @@map("claims")
}

model ClinicalFile {
  id           String     @id @default(uuid()) @db.Char(36)
  clinicId     String     @map("clinic_id") @db.Char(36)
  patientId    String     @map("patient_id") @db.Char(36)
  encounterId  String?    @map("encounter_id") @db.Char(36)
  objectKey    String     @map("object_key") @db.VarChar(255)
  mimeType     String     @map("mime_type") @db.VarChar(255)
  filename     String     @db.VarChar(255)
  uploadedById String?    @map("uploaded_by") @db.Char(36)
  uploadedAt   DateTime   @default(now()) @map("uploaded_at")
  clinic       Clinic     @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "clinical_files_ibfk_1")
  patient      Patient    @relation(fields: [patientId], references: [id], onUpdate: Restrict, map: "clinical_files_ibfk_2")
  encounter    Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clinical_files_ibfk_3")
  uploadedBy   User?      @relation(fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clinical_files_ibfk_4")

  @@index([clinicId], map: "clinic_id")
  @@index([encounterId], map: "encounter_id")
  @@index([patientId], map: "patient_id")
  @@index([uploadedById], map: "uploaded_by")
  @@map("clinical_files")
}

model Contact {
  id               String            @id @default(uuid()) @db.Char(36)
  clinicId         String            @map("clinic_id") @db.Char(36)
  contactType      String            @map("contact_type") @db.VarChar(255)
  fullName         String            @map("full_name") @db.VarChar(255)
  email            String?           @db.VarChar(255)
  phone            String?           @db.VarChar(255)
  preferredChannel String?           @map("preferred_channel") @db.VarChar(255)
  address          String?           @db.VarChar(255)
  marketingOptIn   Boolean           @default(false) @map("marketing_opt_in")
  marketingOptInAt DateTime?         @map("marketing_opt_in_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "contacts_ibfk_1")
  conversations    Conversation[]
  leads            Lead[]
  patientGuardians PatientGuardian[]
  patient          Patient?

  @@index([clinicId, fullName], map: "contacts_search_idx")
  @@map("contacts")
}

model Conversation {
  id            String     @id @default(uuid()) @db.Char(36)
  clinicId      String     @map("clinic_id") @db.Char(36)
  contactId     String     @map("contact_id") @db.Char(36)
  channel       String     @db.VarChar(255)
  assignedToId  String?    @map("assigned_to") @db.Char(36)
  status        String     @default("open") @db.VarChar(255)
  createdAt     DateTime   @default(now()) @map("created_at")
  externalRef   String?    @map("external_ref") @db.VarChar(191)
  lastMessageAt DateTime?  @map("last_message_at")
  clinic        Clinic     @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "conversations_ibfk_1")
  contact       Contact    @relation(fields: [contactId], references: [id], onUpdate: Restrict, map: "conversations_ibfk_2")
  assignedTo    User?      @relation(fields: [assignedToId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "conversations_ibfk_3")
  miaDrafts     MiaDraft[]
  messages      Message[]

  @@unique([clinicId, channel, externalRef], map: "conversations_external_ref")
  @@index([assignedToId], map: "assigned_to")
  @@index([clinicId], map: "clinic_id")
  @@index([contactId], map: "contact_id")
  @@index([clinicId, lastMessageAt], map: "conversations_inbox_idx")
  @@map("conversations")
}

model Encounter {
  id             String          @id @default(uuid()) @db.Char(36)
  clinicId       String          @map("clinic_id") @db.Char(36)
  patientId      String          @map("patient_id") @db.Char(36)
  appointmentId  String?         @map("appointment_id") @db.Char(36)
  dentistId      String?         @map("dentist_id") @db.Char(36)
  occurredAt     DateTime        @default(now()) @map("occurred_at")
  notes          String?         @db.Text
  diagnosis      String?         @db.Text
  clinicalFiles  ClinicalFile[]
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "encounters_ibfk_1")
  patient        Patient         @relation(fields: [patientId], references: [id], onUpdate: Restrict, map: "encounters_ibfk_2")
  appointment    Appointment?    @relation(fields: [appointmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "encounters_ibfk_3")
  dentist        User?           @relation(fields: [dentistId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "encounters_ibfk_4")
  treatmentItems TreatmentItem[]

  @@index([appointmentId], map: "appointment_id")
  @@index([clinicId], map: "clinic_id")
  @@index([dentistId], map: "dentist_id")
  @@index([patientId], map: "patient_id")
  @@map("encounters")
}

model ExpenseEntry {
  id          String   @id @default(uuid()) @db.Char(36)
  clinicId    String   @map("clinic_id") @db.Char(36)
  category    String   @db.VarChar(255)
  amount      Decimal  @db.Decimal(12, 2)
  incurredOn  DateTime @map("incurred_on") @db.Date
  description String?  @db.Text
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "expense_entries_ibfk_1")

  @@index([clinicId], map: "clinic_id")
  @@map("expense_entries")
}

model IntegrationAccount {
  id                  String  @id @default(uuid()) @db.Char(36)
  clinicId            String  @map("clinic_id") @db.Char(36)
  provider            String  @db.VarChar(255)
  config              Json
  credentialSecretRef String? @map("credential_secret_ref") @db.VarChar(255)
  status              String  @default("inactive") @db.VarChar(255)
  clinic              Clinic  @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "integration_accounts_ibfk_1")

  @@index([clinicId], map: "clinic_id")
  @@map("integration_accounts")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Char(36)
  invoiceId   String   @map("invoice_id") @db.Char(36)
  serviceId   String?  @map("service_id") @db.Char(36)
  description String   @db.Text
  qty         Decimal  @db.Decimal(10, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxType     String   @map("tax_type") @db.VarChar(255)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  discount    Decimal  @default(0.00) @db.Decimal(12, 2)
  position    Int      @default(0)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onUpdate: Restrict, map: "invoice_items_ibfk_1")
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_items_ibfk_2")

  @@index([invoiceId], map: "invoice_id")
  @@index([serviceId], map: "service_id")
  @@map("invoice_items")
}

model InvoiceVoidRequest {
  id            String    @id @default(uuid()) @db.Char(36)
  clinicId      String    @map("clinic_id") @db.Char(36)
  invoiceId     String    @map("invoice_id") @db.Char(36)
  requestedById String    @map("requested_by") @db.Char(36)
  reason        String    @db.Text
  status        String    @default("pending") @db.VarChar(255)
  decidedById   String?   @map("decided_by") @db.Char(36)
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  clinic        Clinic    @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "invoice_void_requests_ibfk_1")
  invoice       Invoice   @relation(fields: [invoiceId], references: [id], onUpdate: Restrict, map: "invoice_void_requests_ibfk_2")
  requestedBy   User      @relation("invoice_void_requests_requested_byTousers", fields: [requestedById], references: [id], onUpdate: Restrict, map: "invoice_void_requests_ibfk_3")
  decidedBy     User?     @relation("invoice_void_requests_decided_byTousers", fields: [decidedById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "invoice_void_requests_ibfk_4")

  @@index([clinicId], map: "clinic_id")
  @@index([decidedById], map: "decided_by")
  @@index([invoiceId], map: "invoice_id")
  @@index([requestedById], map: "requested_by")
  @@map("invoice_void_requests")
}

model Invoice {
  id                  String               @id @default(uuid()) @db.Char(36)
  clinicId            String               @map("clinic_id") @db.Char(36)

/// A message sent to many patients at once; each recipient gets a message in their conversation.
model Broadcast {
  id             String    @id @default(uuid()) @db.Char(36)
  clinicId       String    @map("clinic_id") @db.Char(36)
  title          String    @db.VarChar(120)
  body           String    @db.Text
  audience       String    @db.VarChar(40)
  recipientCount Int       @default(0) @map("recipient_count")
  createdById    String?   @map("created_by") @db.Char(36)
  createdAt      DateTime  @default(now()) @map("created_at")
  clinic         Clinic    @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "broadcasts_clinic_fkey")
  createdBy      User?     @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "broadcasts_created_by_fkey")
  messages       Message[]

  @@index([clinicId, createdAt], map: "broadcasts_clinic_created")
  @@index([createdById], map: "broadcasts_created_by")
  @@map("broadcasts")
}

/// A reply Mia (crwdForce) suggested for a conversation; staff use or dismiss it.
model MiaDraft {
  id             String       @id @default(uuid()) @db.Char(36)
  clinicId       String       @map("clinic_id") @db.Char(36)
  conversationId String       @map("conversation_id") @db.Char(36)
  reply          String       @db.Text
  summary        String       @db.Text
  intent         String       @db.VarChar(40)
  nextStep       String       @map("next_step") @db.VarChar(40)
  slotLabel      String?      @map("slot_label") @db.VarChar(120)
  handover       Boolean      @default(false)
  handoverReason String?      @map("handover_reason") @db.VarChar(255)
  status         String       @default("pending") @db.VarChar(20)
  model          String       @db.VarChar(60)
  inputTokens    Int          @default(0) @map("input_tokens")
  outputTokens   Int          @default(0) @map("output_tokens")
  createdById    String?      @map("created_by") @db.Char(36)
  createdAt      DateTime     @default(now()) @map("created_at")
  decidedAt      DateTime?    @map("decided_at")
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onUpdate: Restrict, map: "mia_drafts_clinic_fkey")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onUpdate: Restrict, map: "mia_drafts_conversation_fkey")
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "mia_drafts_created_by_fkey")

  @@index([clinicId, createdAt], map: "mia_drafts_clinic_created")
  @@index([conversationId], map: "mia_drafts_conversation")
  @@index([createdById], map: "mia_drafts_created_by")
  @@map("mia_drafts")
}
